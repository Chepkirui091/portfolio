# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# Generated CVs, resumes, and cover letters (keep local; do not push)
docs/*.pdf
docs/*.docx
docs/*.md
docs/_resume_extract/
docs/_resume.zip
docs/resume-private.json
public/*.pdf
public/**/*.pdf

# Local screenshots (keep folders; add your screenshots under public/ on each machine)
public/**/*.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.webp
public/**/*.gif
public/**/*.zip
# Profile photos must ship with the site
!public/profile/*.jpg
!public/profile/*.jpeg
!public/profile/*.webp
!public/profile/*.png
public/profile/iCloud*/
public/profile/**/3D6238E0*

# Cursor / local assets
assets/
